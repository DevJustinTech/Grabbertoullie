# Virtualenvs (huge, host-specific)
.venv/
venv/

# Python caches
__pycache__/
*.pyc

# Secrets & logs (provided via Space secrets/env, never baked into the image)
.env
*.log

# Local-only dev/debug/test scripts and scratch files
debug_*.py
test_*.py
test_annas_mirrors.py
tests/
_*.py

# Tooling / editor config not needed at runtime
.pyre_configuration
pyrightconfig.json
setup.cfg
.gitignore
